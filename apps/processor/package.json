{
  "name": "processor",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "text_processor": "bun run src/text_processor.ts",
    "video_processor": "bun run src/video_processor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "bun build src/text_processor.ts src/video_processor.ts --outdir=dist --target=bun"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  }
}
