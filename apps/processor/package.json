{
  "name": "processor",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@eslint/js": "^9.17.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.0"
  },
  "scripts": {
    "start": "dotenv -e ../../.env -- bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "bun build src/index.ts --outdir=dist --target=bun"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  }
}
