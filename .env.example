# Copy to .env at repo root: cp .env.example .env
# Scripts load this via dotenv-cli (see package.json).

# --- Database ---
DATABASE_URL=postgresql://postgres:testimonials@localhost:5432/testimonials

# --- Web (Next.js) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_SSL=false
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=testiflow
S3_PUBLIC_CUSTOM_DOMAIN=

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379
# Single list: web rpush + unified processor blpop
REDIS_QUEUE=text-queue
# Legacy names (unused by unified worker; safe to omit)
REDIS_TEXT_QUEUE=text-queue
REDIS_VIDEO_QUEUE=video-queue

# --- Processor ---
APP_URL=http://localhost:3000
OPENROUTER_API_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_METRICS_QUERY_URL=
POSTHOG_QUERY_TOKEN=

# --- Uploads ---
NEXT_PUBLIC_UPLOAD_VIDEO_MAX_SIZE=5
NEXT_PUBLIC_UPLOAD_VIDEO_MAX_DURATION=5
